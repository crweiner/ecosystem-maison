---
import '@fontsource-variable/pixelify-sans';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Keep utility pages (such as the /wander/ redirect) out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2a1b3d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ecosystem.maison" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A pixel-art deer grazing by a forest pond at sunrise, beside a wooden sign reading Welcome to our Ecosystem." />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Mark scripting before first paint, so a visit without it keeps the still sky. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sky-fallback" aria-hidden="true"></div>
    <slot name="world" />
    <div class="page">
      <slot />
    </div>
    <slot name="overlay" />
  </body>
</html>
