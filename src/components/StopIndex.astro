---
import type { Product } from '../data/products';

interface Props {
  products: Product[];
}
const { products } = Astro.props;
---

<nav class="index" aria-label="Ecosystem products">
  <ol>
    {
      products.map((p) => (
        <li>
          <a href={`#${p.slug}`} data-index-link={p.slug}>
            <span class="index__label">{p.name}</span>
            <span class="index__tick" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .index {
    position: fixed;
    top: 50%;
    right: max(clamp(0.75rem, 2vw, 2rem), env(safe-area-inset-right));
    z-index: 5;
    transform: translateY(-50%);
    transition:
      opacity 240ms var(--ease-out),
      visibility 0s linear 0s;
  }

  /*
   * At the close the sign owns that corner and "Back to the top" does the
   * navigating, so the index steps aside: faded, and out of reach of the
   * pointer and the Tab key until the visitor scrolls back up.
   */
  :global(html.at-close) .index {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 240ms var(--ease-out),
      visibility 0s linear 240ms;
  }

  ol {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * The link is only the tick's square: a full 44px target, and nothing wider.
   * The product name floats to its left on hover or focus, outside the hit
   * area, so hidden names can never catch the pointer over the page.
   */
  a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 2.75rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .index__label {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.25rem);
    white-space: nowrap;
    pointer-events: none;
    font-family: var(--font-pixel);
    font-size: var(--type-caption);
    font-weight: 500;
    opacity: 0;
    transform: translate(var(--px), -50%);
    transition:
      opacity 200ms steps(3, end),
      transform 200ms steps(3, end);
    text-shadow: var(--type-shadow);
  }

  /* A pixel square that grows to a bar at the current clearing. */
  /* Drawn at full length and scaled down at rest, so it grows without relayout. */
  .index__tick {
    width: calc(var(--px) * 5);
    height: calc(var(--px) * 2);
    background: var(--ink-faint);
    box-shadow: 0 max(2px, calc(var(--px) / 2)) 0 rgb(8 8 14 / 0.6);
    transform: scaleX(0.4);
    transform-origin: right;
    transition:
      transform 200ms steps(3, end),
      background-color 200ms steps(2, end);
  }

  a:hover .index__label,
  a:focus-visible .index__label {
    opacity: 1;
    transform: translate(0, -50%);
  }

  a:hover .index__tick,
  a:focus-visible .index__tick {
    background: var(--ink);
  }

  a[aria-current] {
    color: var(--ink);
  }

  a[aria-current] .index__tick {
    transform: none;
    background: var(--gold);
  }

  /* Phones and short landscape screens: ticks only. */
  @media (max-width: 759px), (max-height: 520px) {
    .index {
      right: max(0.25rem, env(safe-area-inset-right));
    }

    a {
      min-height: 2.25rem;
    }

    .index__label {
      display: none;
    }
  }

  @media (pointer: coarse) {
    a {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }

  @media (pointer: coarse) and (max-height: 520px) {
    a {
      min-height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index__label,
    .index__tick {
      transition: none;
    }
  }
</style>
