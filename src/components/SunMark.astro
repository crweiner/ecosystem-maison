---
/**
 * The masthead's day clock: a dotted arc with a pixel sun that climbs and
 * sets as the visitor scrolls through the forest's day.
 */
const R = 7;
const dots: [number, number][] = [];
for (let i = 0; i <= 12; i++) {
  const a = Math.PI - (i / 12) * Math.PI;
  const p: [number, number] = [Math.round(R + 1 + Math.cos(a) * R), Math.round(R + 1 - Math.sin(a) * R)];
  if (!dots.some(([x, y]) => x === p[0] && y === p[1])) dots.push(p);
}
---

<svg class="sunmark" viewBox={`0 0 ${2 * R + 3} ${R + 3}`} shape-rendering="crispEdges" aria-hidden="true" data-radius={R}>
  {dots.map(([x, y], i) => i % 2 === 0 && <rect x={x} y={y} width="1" height="1" class="sunmark__dot" />)}
  <rect x="0" y={R + 2} width={2 * R + 3} height="1" class="sunmark__ground" />
  <rect x="0" y={R} width="3" height="3" class="sunmark__sun" data-sun />
</svg>

<style>
  .sunmark {
    width: calc(var(--px) * 17);
    min-width: 34px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 max(2px, calc(var(--px) / 2)) 0 rgb(8 8 14 / 0.6));
  }

  .sunmark__dot {
    fill: var(--ink-faint);
  }

  .sunmark__ground {
    fill: var(--ink-soft);
  }

  .sunmark__sun {
    fill: var(--gold);
  }
</style>
